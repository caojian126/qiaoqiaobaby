# 服务端口
PORT=3000

# Supabase 配置（用于记录收发信息）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 写入的表名（默认 chat_messages）
SUPABASE_TABLE=chat_messages

# 额外固定字段（JSON 对象，可选。如果你的表有必填列，在这里补固定值）
# 例如：{"assistant_id":"gateway","conversation_id":"default"}
SUPABASE_EXTRA_FIELDS={}

# 上游供应商列表（JSON 数组，必须写在一行）
# name:      供应商唯一名称
# base_url:  上游地址（统一到 /v1 这一级）
# api_key:   上游 API Key
# models:    该供应商提供的模型列表（"*" 表示兜底通配）
# format:    上游原生格式，openai 或 anthropic
PROVIDERS=[{"name":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-xxx","models":["gpt-4o","gpt-4o-mini"],"format":"openai"},{"name":"claude","base_url":"https://api.anthropic.com/v1","api_key":"sk-ant-xxx","models":["claude-3-5-sonnet-20241022"],"format":"anthropic"},{"name":"relay","base_url":"https://your-relay.com/v1","api_key":"sk-relay-xxx","models":["*"],"format":"openai"}]
